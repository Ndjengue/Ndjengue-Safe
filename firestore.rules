rules_version = '2';

// Regras do Firestore para o Controlo Parental (plano gratuito Spark).
// Publicar em: Firebase Console > Firestore Database > Regras.
//
// Modelo de confiança:
//  - O pai (donoUid) gere tudo na sua família.
//  - O telemóvel da criança autentica-se anonimamente, valida um convite de 6 dígitos
//    e fica registado em familias/{fid}/membros/{uid}. A partir daí lê e escreve
//    apenas dentro dessa família.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function eDono(fid) {
      return autenticado() &&
        get(/databases/$(database)/documents/familias/$(fid)).data.donoUid == request.auth.uid;
    }

    // Usado em escritas em lote em que a família é criada na mesma operação.
    function eDonoDepois(fid) {
      return autenticado() &&
        getAfter(/databases/$(database)/documents/familias/$(fid)).data.donoUid == request.auth.uid;
    }

    function eMembro(fid) {
      return autenticado() &&
        exists(/databases/$(database)/documents/familias/$(fid)/membros/$(request.auth.uid));
    }

    // ---------- Convites de emparelhamento ----------
    match /convites/{codigo} {
      allow get: if autenticado();
      allow list: if false;
      allow create: if autenticado() && eDono(request.resource.data.familiaId);
      allow update: if false;
      allow delete: if autenticado();
    }

    // ---------- Família ----------
    match /familias/{fid} {
      allow get: if autenticado() &&
        (resource.data.donoUid == request.auth.uid || eMembro(fid));
      // Permite a query "where donoUid == uid" do pai.
      allow list: if (autenticado() && resource.data.donoUid == request.auth.uid) || eSuperAdmin();
      allow create: if autenticado() && request.resource.data.donoUid == request.auth.uid;
      allow update, delete: if autenticado() && resource.data.donoUid == request.auth.uid;

      match /membros/{uid} {
        allow read: if eDono(fid) || eMembro(fid);
        allow create: if autenticado() && (
          eDonoDepois(fid) ||
          (
            request.auth.uid == uid &&
            request.resource.data.papel == 'filho' &&
            exists(/databases/$(database)/documents/convites/$(request.resource.data.codigo)) &&
            get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.familiaId == fid &&
            get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.expiraEm > request.time.toMillis()
          )
        );
        allow update: if false;
        allow delete: if eDono(fid);
      }

      match /segredo/{doc} {
        allow read: if eDono(fid) || eMembro(fid);
        allow write: if eDonoDepois(fid);
      }

      match /dispositivos/{did} {
        allow read: if eDono(fid) || eMembro(fid);
        allow create, delete: if eDono(fid);
        allow update: if eDono(fid) || eMembro(fid);

        match /{sub}/{doc} {
          allow read, write: if eDono(fid) || eMembro(fid);
        }
      }

      match /pedidos/{id} {
        allow read, create, update: if eDono(fid) || eMembro(fid);
        allow delete: if eDono(fid);
      }

      match /alertas/{id} {
        allow read, create: if eDono(fid) || eMembro(fid);
        allow update, delete: if eDono(fid);
      }
    }

    // =====================================================================
    // NOVA APP: Super Administrador e retenção de dados (plano Spark, sem Functions)
    // =====================================================================

    // O Super Administrador é um documento admins/{uid} criado À MÃO na consola Firebase.
    // Nenhum cliente consegue escrever aqui, por isso ninguém se promove a si próprio.
    function eSuperAdmin() {
      return autenticado() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function diasRetencao() {
      return get(/databases/$(database)/documents/config/retencao).data.dias;
    }

    // expiresAt nunca pode ultrapassar criadoEm (hora do servidor) + dias da política (+5 min de
    // tolerância do relógio). O cliente pode encurtar mas nunca prolongar a retenção.
    function expiracaoValida() {
      return request.resource.data.criadoEm == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt < request.time + duration.value(diasRetencao(), 'd') + duration.value(5, 'm');
    }

    function aindaValido() {
      return resource.data.expiresAt > request.time;
    }

    // O admin só pode alterar expiresAt (recálculo da política) ou apagar.
    function adminSoExpiracao() {
      return eSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt']);
    }

    function eParticipante(cid) {
      return autenticado() &&
        request.auth.uid in get(/databases/$(database)/documents/conversas/$(cid)).data.participantes;
    }

    // Só para contagens do painel do super admin (a app não lê o conteúdo).
    match /{path=**}/dispositivos/{did} {
      allow read: if eSuperAdmin();
    }

    match /admins/{uid} {
      allow get: if autenticado() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /config/retencao {
      allow read: if autenticado();
      allow create, update: if eSuperAdmin() &&
        request.resource.data.dias is int &&
        request.resource.data.dias >= 1 && request.resource.data.dias <= 365 &&
        request.resource.data.alteradoPor == request.auth.uid &&
        request.resource.data.alteradoEm == request.time;
      allow delete: if false;
    }

    // Auditoria: só se cria, nunca se edita nem apaga; só o super admin lê.
    match /auditoria/{id} {
      allow read: if eSuperAdmin();
      allow create: if eSuperAdmin() && request.resource.data.adminUid == request.auth.uid &&
        request.resource.data.criadoEm == request.time;
      allow update, delete: if false;
    }

    // Registo operacional de cada limpeza (sem conteúdo de mensagens).
    match /limpezas/{id} {
      allow read: if eSuperAdmin();
      allow create, update: if eSuperAdmin();
      allow delete: if false;
    }

    match /conversas/{cid} {
      allow read: if autenticado() && request.auth.uid in resource.data.participantes;
      allow create: if autenticado() && request.auth.uid in request.resource.data.participantes;
      allow update, delete: if false;
    }

    match /mensagens/{id} {
      allow read: if (aindaValido() && eParticipante(resource.data.conversaId)) || eSuperAdmin();
      allow create: if eParticipante(request.resource.data.conversaId) &&
        request.resource.data.autorUid == request.auth.uid && expiracaoValida();
      allow update: if adminSoExpiracao();
      allow delete: if eSuperAdmin();
    }

    match /publicacoes/{id} {
      allow read: if (aindaValido() && autenticado()) || eSuperAdmin();
      allow create: if autenticado() && request.resource.data.autorUid == request.auth.uid && expiracaoValida();
      allow update: if adminSoExpiracao();
      allow delete: if eSuperAdmin();
    }

    match /comentarios/{id} {
      allow read: if (aindaValido() && autenticado()) || eSuperAdmin();
      allow create: if autenticado() && request.resource.data.autorUid == request.auth.uid && expiracaoValida();
      allow update: if adminSoExpiracao();
      allow delete: if eSuperAdmin();
    }

    match /reacoes/{id} {
      allow read: if (aindaValido() && autenticado()) || eSuperAdmin();
      allow create: if autenticado() && request.resource.data.autorUid == request.auth.uid && expiracaoValida();
      allow update: if adminSoExpiracao();
      allow delete: if eSuperAdmin();
    }

    // Chamadas: só metadados (nunca gravação). Retenção própria fixa de 30 dias.
    match /chamadas/{id} {
      allow read: if (resource.data.expiresAt > request.time && request.auth.uid in resource.data.participantes) || eSuperAdmin();
      allow create: if autenticado() && request.auth.uid in request.resource.data.participantes &&
        request.resource.data.criadoEm == request.time &&
        request.resource.data.expiresAt > request.time + duration.value(30, 'd') - duration.value(5, 'm') &&
        request.resource.data.expiresAt < request.time + duration.value(30, 'd') + duration.value(5, 'm');
      allow update: if false;
      allow delete: if eSuperAdmin();
    }
  }
}
